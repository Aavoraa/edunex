# ---------------------------------------------------------------------------
# Edunex on Vercel: copy to .env.vercel and fill in the four secrets
# (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# Never commit .env.vercel.
# Import: Vercel -> Project -> Settings -> Environment Variables -> "Import .env"
# (or paste this whole file into the first Key field). Apply to Production and Preview.
#
# DATABASE_URL is NOT here: add Neon from Vercel -> Storage -> Create Database -> Neon and
# connect it to this project; Neon sets DATABASE_URL itself. Do not set EXAM_VISION_URL either:
# the service binding in vercel.json sets it.
# ---------------------------------------------------------------------------
NODE_ENV=production
DATABASE_SSL=require
DATABASE_POOL_MAX=3

JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=true
# Your own domain(s), comma-separated. The *.vercel.app addresses are allowed automatically.
CORS_ORIGINS=

# Vercel Cron sends this to /api/internal/cron/notifications
CRON_SECRET=

# Paper Correction: shared by the API and the FastAPI service (both read EXAM_VISION_SECRET)
EXAM_VISION_SECRET=

# Uploaded documents. 'local' works but files vanish on Vercel; for real use switch to s3
# and fill in an S3-compatible bucket (Cloudflare R2, AWS S3, Supabase Storage).
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

LOG_LEVEL=info
