# ---------------------------------------------------------------------------
# Edunex Smart School 360 — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (the local cluster in .pgdata, port 5544).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5544/edunex
DATABASE_POOL_MAX=10

# JWT — use long random values (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=edunex-api
JWT_AUDIENCE=edunex-clients

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Cookie settings for the web refresh token (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=20

# Uploads: files under UPLOAD_DIR, served only through authorised API routes
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Maps — Leaflet + OpenStreetMap needs no key. Set these to switch tile provider.
# GPS devices (POST /api/v1/location). Device tokens need no extra secret: only their SHA-256 is stored.
LOCATION_INTERVAL_SECONDS=30
ONLINE_THRESHOLD_SECONDS=120
OFFLINE_THRESHOLD_SECONDS=600
LOCATION_MAX_FUTURE_SECONDS=300
LOCATION_MAX_AGE_HOURS=72
DEVICE_RATE_LIMIT_PER_MINUTE=30

MAP_API_KEY=
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Seed data password for every demo account (development only)
SEED_DEMO_PASSWORD=

# Notification channels — leave blank to keep deliveries queued (no external calls)
# WhatsApp: 'gateway' (JSON {to, message} + Bearer token — e.g. NeverSkip or another BSP)
# or 'meta' (WhatsApp Cloud API: https://graph.facebook.com/v21.0/<phone-number-id>/messages)
WHATSAPP_PROVIDER=gateway
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Meta only: approved template with two body parameters (title, details)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91
SMS_API_URL=
SMS_API_KEY=
SMTP_URL=
PUSH_FCM_SERVER_KEY=

# Paper Correction (exam-vision/ — Claude reads and marks handwritten answer sheets).
# The service runs on its own port; set the same secret there as EXAM_GATEWAY_SECRET.
# Leave EXAM_VISION_URL blank to switch the module off.
EXAM_VISION_URL=
EXAM_VISION_SECRET=

LOG_LEVEL=info

# Web dev server: where Vite forwards /api (default http://127.0.0.1:4000)
VITE_API_PROXY=

# Automated tests use a separate database (default: <DATABASE_URL database>_test)
TEST_DATABASE_URL=
