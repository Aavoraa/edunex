{
  "name": "edunex-smart-school-360",
  "version": "1.0.0",
  "private": true,
  "description": "Edunex Smart School 360 — full-stack school management platform (web + common REST API + PostgreSQL)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:migrate:neon": "npm run db:migrate:neon --workspace backend",
    "db:seed:neon": "npm run db:seed:neon --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "db:top-up": "npm run db:top-up --workspace backend --",
    "db:sample-files": "npm run db:sample-files --workspace backend",
    "test": "npm run test --workspace backend",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "test:db": "npm run test:db --workspace backend",
    "db:local:init": "node scripts/local-db.mjs init",
    "test:screens": "npm run test:screens --workspace frontend"
  },
  "engines": {
    "node": ">=20"
  }
}
