# Neon database, used only from this PC to create the tables and load demo data.
# Copy to .env.neon, paste Neon's connection string (Vercel -> Storage -> your Neon
# database -> .env.local tab, DATABASE_URL_UNPOOLED or DATABASE_URL), then run
#   npm run db:migrate:neon
#   npm run db:seed:neon
DATABASE_URL=
DATABASE_SSL=require
# Password for every demo account created by db:seed:neon (8+ characters)
SEED_DEMO_PASSWORD=
